DATABASE_URL=postgres://settlehex:settlehex@localhost:55432/settlehex
POSTGRES_DB=settlehex
POSTGRES_USER=settlehex
POSTGRES_PASSWORD=settlehex
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GAME_SERVER_ORIGIN=http://localhost:8000
GAME_SERVER_INTERNAL_URL=http://localhost:8080

# Native SettleGraph (disabled by default; V2 flags retained for compatibility).
# Install/select once with pnpm bot:promote. Default local selection: .local/bot/current.json.
SETTLEHEX_SETTLEGRAPH_V2_ENABLED=0
NEXT_PUBLIC_SETTLEHEX_SETTLEGRAPH_V2=0
SETTLEHEX_SETTLEGRAPH_V2_TIMEOUT_MS=3000
# Optional selection/worker overrides (leave unset for the local defaults):
# SETTLEHEX_BOT_MODEL_MANIFEST=/absolute/bot/current.json
# SETTLEHEX_SETTLEGRAPH_V2_WORKER=/absolute/settlegraph-v2-worker
# Production: external model store mounted read-only by web and game.
SETTLEHEX_BOT_MODELS_DIR=/srv/settlex-models
SITE_HOST=http://localhost
SESSION_SECRET=change-me
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opt-in Match alerts (Web Push)
VAPID_SUBJECT=mailto:hello@settlehex.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
